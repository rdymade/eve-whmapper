@using Blazor.Diagrams.Components.Renderers;
@using WHMapper.Models.Custom.Node;
@using WHMapper.Models.DTO.EveMapper.Enums;


<MudCard Outlined="true" Style="@systemStyle" Class="_class">
    <MudCardHeader Class="mb-n2 pa-1 mx-1">
        <CardHeaderAvatar>
        <div Class="d-flex flex-row justify-space-between">
            @if (_isEditingTag)
            {
                <MudTextField @bind-Value="_editedTag"
                      Immediate="true"
                      @onblur="@(() => SaveTag())"
                      @onkeyup="@((e) => OnKeyUp(e))"
                      Class="d-flex align-self-center mr-1 justify-start"
                      Style="@($"color:{_systemColor}; font-weight:normal; width: 60px;")"
                      Variant="Variant.Text"
                      Margin="Margin.Dense"
                      AutoFocus="true" />
            }
            else
            {   
                <MudText class="d-flex align-self-center mr-1 justify-start" Typo="Typo.body1" Style="@($"color:{_systemColor}; font-weight:normal;")" @ondblclick="StartEditingTag">@Node.SystemTag</MudText>
            }
            <MudText Class="d-flex align-self-center justify-end" Typo="Typo.body1" Style="@($"color:{_systemColor}; font-weight:bold;")" Size="Size.Small" Variant="Variant.Outlined" @ondblclick="StartEditingTag">@Node.SystemType.ToDescriptionString()</MudText>
        </div>
        </CardHeaderAvatar>
        <CardHeaderContent>
            @if (_isEditingName)
            {
                <MudTextField @bind-Value="_editedName"
                      Immediate="true"
                      @onblur="@(() => SaveName())"
                      @onkeyup="@((e) => OnKeyUp(e))"
                      Class="ml-n3 mr-2"
                      Style="font-weight:bold; width: 120px;"
                      Variant="Variant.Text"
                      Margin="Margin.Dense"
                      AutoFocus="true" />
            }
            else
            {   
                @if(Node.AlternateName!=null)
                {
                    <MudText class="ml-n3 mr-2" Typo="Typo.body1" Style="font-weight:bold;" @ondblclick="StartEditingName">@Node.AlternateName</MudText>

                }
                else
                {
                    <MudText class="ml-n3 mr-2" Typo="Typo.body1" Style="font-weight:bold;" @ondblclick="StartEditingName">@Node.Name</MudText>
                }
            }
        </CardHeaderContent>
        <CardHeaderActions>
            @if (Locked)
            {
                <MudIcon Class="mt-3 mr-2" Icon="@Icons.Material.Sharp.Lock" Size="Size.Small" Style="margin-top:-3px" />
            }
            @if (Node != null && Node.Effect != WHMapper.Models.DTO.EveMapper.Enums.WHEffect.None)
            {
                <MudTooltip Text="@Node.Effect.ToString()" Arrow="true" Placement="Placement.Bottom">
                    <ChildContent>
                        <MudIcon Class="mt-3 mr-2" Icon="@Icons.Material.Filled.Square" Style="@($"color:{_whEffectColor};")" Size="Size.Small"/>
                    </ChildContent>
                    <TooltipContent>
                        <MudPaper Class="d-flex flex-column flex-grow-1 gap-0" Elevation="0">
                            @if (Node != null && Node.EffectDetails!=null)
                            {
                                foreach (var effectInfo in Node.EffectDetails)
                                {
                                    <MudText class="ml-1 mr-1" Typo="Typo.caption">@effectInfo.Name. : @effectInfo.Value%</MudText>
                                }
                            }
                        </MudPaper>
                    </TooltipContent>
                </MudTooltip>
            }
        </CardHeaderActions>
    </MudCardHeader>

    <MudCardContent Class="d-flex pa-1 mx-1 flex-column justify-space-between">
        <div Class="d-flex flex-row justify-space-between">
            <div Class="d-flex">
                @if (Node != null && Node.ConnectedUsers != null && Node.ConnectedUsers.FirstOrDefault() != null)
                {
                    <MudTooltip Arrow="true" Placement="Placement.Bottom">
                        <ChildContent>
                            <MudIcon Icon="@Icons.Material.Filled.Group" Color=Color.Default Size="Size.Small" />
                        </ChildContent>
                        <TooltipContent>
                            <MudPaper Class="d-flex flex-column flex-grow-1 gap-0" Elevation="0">
                                @foreach (var user in @Node.ConnectedUsers)
                                {
                                    <MudText class="mx-1" Typo="Typo.caption">@user</MudText>
                                }
                            </MudPaper>
                        </TooltipContent>
                    </MudTooltip>
                    <MudText Class="align-self-stretch ml-1 mt-1" Typo="Typo.caption">@Node?.ConnectedUsers?.FirstOrDefault()</MudText>
                }
            </div>
            <div Class="d-flex align-self-center justify-end">
                @if (Node != null && Node.Statics != null && Node?.Statics.Count() > 0)
                {
                    @foreach (var item in Node.Statics)
                    {
                        <MudText Class="align-self-center mt-1 ml-1" Typo="Typo.caption" Style="@($"color:{WHColorHelper.GetSystemTypeColor(@item.Destination)};")">@item.Destination.ToString()</MudText>
                    }
                }
            </div>
        </div>
    </MudCardContent>
</MudCard>



